  "item": [
    {
      "id": "a9f6fdb0-6e60-4e79-b994-290a31b43583",
      "name": "Entities",
      "description": {
        "content": "**`Entities` represent a business or organization that uses the API, and their customers.**\n\nDinari Partners are represented as an organization `Entity` in the API, with their own accounts.\nIndividual customers of Partner `Entities` are also represented as `Entities` in the API, which are managed by the Partner `Entity`.",
        "type": "text/plain"
      },
