        {
          "info": {
            "name": "Get Alloys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-enterprise.sbt.dinari.com/api/v2/market_data/alloys/",
            "params": [
              {
                "name": "symbols",
                "value": "",
                "type": "query",
                "description": "If set, this endpoint will return Alloys that match the symbols specified"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort order"
              },
              {
                "name": "next",
                "value": "",
                "type": "query",
                "description": "Cursor for next page"
              },
              {
                "name": "previous",
                "value": "",
                "type": "query",
                "description": "Cursor for previous page"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key-Id",
              "value": "{{X-API-Key-Id}}",
              "placement": "header"
            }
          },
          "docs": "Returns available `Alloys` with cursor-based pagination."
        },
        {
          "info": {
            "name": "Get Alloy current price",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-enterprise.sbt.dinari.com/api/v2/market_data/alloys/:alloy_id/current_price",
            "params": [
              {
                "name": "alloy_id",
                "value": "",
