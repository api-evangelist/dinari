          "info": {
            "name": "Get Stock Splits for Stock",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-enterprise.sbt.dinari.com/api/v2/market_data/stocks/:stock_id/splits",
            "params": [
              {
                "name": "stock_id",
