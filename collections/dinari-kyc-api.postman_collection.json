{
  "item": [
    {
      "id": "6e7515e0-61f1-4ee8-89e8-c463e8d81785",
      "name": "KYC",
      "description": {
        "content": "**KYC (Know Your Customer) is a process of verifying the identity of customer `Entities`.**\n\nKYC is required for all customer `Entities` that transact on Dinari's platform.\n\nDinari provides a managed KYC process for its Partners, which provides a convenient KYC flow URL to present to the end customer.\n\nFor Dinari Partners that supply their own KYC data, the API provides a way to record a customer's KYC information using the Partner's KYC data. This requires an existing KYC agreement between Dinari and the Partner.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "27dc6360-2f1d-497d-971e-32c5e011ef9c",
          "name": "Get KYC Data",
          "request": {
            "name": "Get KYC Data",
            "description": {
              "content": "\nGet most recent KYC data of the `Entity`.\n\nIf there are any completed KYC checks, data from the most recent one will be returned.\nIf there are no completed KYC checks, the most recent KYC check information, regardless of status, will be returned.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "entities",
                ":entity_id",
