          "name": "Create Withdrawal Request",
          "request": {
            "name": "Create Withdrawal Request",
            "description": {
              "content": "\nRequest to withdraw USD+ payment tokens from a managed `Account` and send the equivalent amount of USDC to the specified recipient `Account`.\n\nThe recipient `Account` must belong to the same `Entity` as the managed `Account`.\n",
              "type": "text/plain"
            },
            "url": {
