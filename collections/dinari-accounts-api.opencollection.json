          "http": {
            "method": "GET",
            "url": "https://api-enterprise.sbt.dinari.com/api/v2/accounts/:account_id/token_transfers/:transfer_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "transfer_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key-Id",
              "value": "{{X-API-Key-Id}}",
              "placement": "header"
            }
          },
          "docs": "\nGet a specific `TokenTransfer` made from this `Account` by its ID.\n\nA `TokenTransfer` represents a transfer of tokens through the Dinari platform from one `Account` to another.\nAs such, only `Account`s that are connected to Dinari-managed `Wallet`s can initiate `TokenTransfer`s.\n"
        }
