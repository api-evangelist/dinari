        },
        {
          "info": {
            "name": "Get Brokerage Account Activities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-enterprise.sbt.dinari.com/api/v2/accounts/:account_id/activities/brokerage",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The maximum number of entries to return in the response. Defaults to 100."
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query",
                "description": "Pagination token. Set to the `id` field of the last Activity returned in the previous page to get the next page of results."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key-Id",
              "value": "{{X-API-Key-Id}}",
              "placement": "header"
            }
          },
          "docs": "\nGet a list of brokerage activities tied to the specified `Account`.\n\n**⚠️ ALPHA: This endpoint is in early development and subject to breaking changes.**\n"
        },
        {
          "info": {
            "name": "Get TokenTransfers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-enterprise.sbt.dinari.com/api/v2/accounts/:account_id/token_transfers",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort order"
              },
              {
                "name": "next",
                "value": "",
                "type": "query",
                "description": "Cursor for next page"
              },
              {
                "name": "previous",
                "value": "",
                "type": "query",
                "description": "Cursor for previous page"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key-Id",
              "value": "{{X-API-Key-Id}}",
              "placement": "header"
            }
          },
          "docs": "\nGet `TokenTransfer`s made from this `Account`.\n\nA `TokenTransfer` represents a transfer of tokens through the Dinari platform from one `Account` to another.\nAs such, only `Account`s that are connected to Dinari-managed `Wallet`s can initiate `TokenTransfer`s.\n"
        },
        {
          "info": {
            "name": "Create TokenTransfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-enterprise.sbt.dinari.com/api/v2/accounts/:account_id/token_transfers",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key-Id",
              "value": "{{X-API-Key-Id}}",
              "placement": "header"
            }
          },
          "docs": "\nCreates a `TokenTransfer` from this `Account`.\n\nA `TokenTransfer` represents a transfer of tokens through the Dinari platform from one `Account` to another.\nAs such, only `Account`s that are connected to Dinari-managed `Wallet`s can initiate `TokenTransfer`s.\n"
        },
        {
          "info": {
            "name": "Get TokenTransfer by ID",
            "type": "http"
