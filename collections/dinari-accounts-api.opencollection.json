            "auth": {
              "type": "apikey",
              "key": "X-API-Key-Id",
              "value": "{{X-API-Key-Id}}",
              "placement": "header"
            }
          },
          "docs": "Create a new `Account` for a specific `Entity`. This `Entity` represents your organization itself, or an individual customer of your organization."
        },
        {
