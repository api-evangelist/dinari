      "items": [
        {
          "info": {
            "name": "Get Accounts for Entity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-enterprise.sbt.dinari.com/api/v2/entities/:entity_id/accounts",
            "params": [
              {
                "name": "entity_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort order"
              },
              {
                "name": "next",
                "value": "",
                "type": "query",
                "description": "Cursor for next page"
              },
              {
                "name": "previous",
                "value": "",
                "type": "query",
                "description": "Cursor for previous page"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key-Id",
              "value": "{{X-API-Key-Id}}",
              "placement": "header"
            }
          },
          "docs": "Get a list of all `Accounts` that belong to a specific `Entity`. This `Entity` represents your organization itself, or an individual customer of your organization."
        },
        {
          "info": {
            "name": "Create Account for Entity",
            "type": "http"
